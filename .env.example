# den-mcp's environment. Unset and empty both mean "not configured".

# den-atlas, plain HTTP on the LAN (required).
ATLAS_URL=http://den-atlas:8080
# The https origin clients reach /mcp on: the resource a token must name (required).
PUBLIC_ORIGIN=https://den.example
# Where Den Web's pages are, for the link on every result. Defaults to PUBLIC_ORIGIN.
WEB_ORIGIN=
# The authorization server whose tokens are accepted (den-edge's OAUTH_ISSUER). Defaults to PUBLIC_ORIGIN.
TOKEN_ISSUER=
# den-edge's Ed25519 public key(s), unpadded base64url, comma-separated during a rotation. Without one every call
# to /mcp is refused and /health says so.
TOKEN_PUBLIC_KEYS=
# Tool calls one session may make a minute, and at once.
# Library writes (optional): den-mcp's X-Wing secret, from `cargo run --example writekey`. Unset, no write tool exists.
MCP_WRITE_KEY=
# den-edge on den.network, bare http:// origin; required with MCP_WRITE_KEY.
EDGE_URL=
RATE_PER_MINUTE=120
RATE_BURST=30
# Extra Origins a browser-based MCP client may call from.
ALLOWED_ORIGINS=
METRICS_TOKEN=
LOG_REQUESTS=1
PORT=8096

# Experimental paid open-vocabulary facets are OFF unless this is exactly 1. Enabling requires every bound below,
# a pinned model (never jev-latest), and a corpus id changed whenever the Atlas dataset changes.
OPEN_FACETS_ENABLED=0
OPEN_FACETS_ENDPOINT=https://api.typesafe.ai/v1/systemone
OPEN_FACETS_MODEL=
OPEN_FACETS_CORPUS=
OPEN_FACETS_STATE_DIR=
OPEN_FACETS_MAX_CANDIDATES=50
OPEN_FACETS_MAX_CALLS=10
OPEN_FACETS_MAX_INPUT_TOKENS=20000
OPEN_FACETS_DOLLARS_PER_BILLION_INPUT_TOKENS=42
OPEN_FACETS_MAX_COST_NANO_USD=840000
OPEN_FACETS_TIMEOUT_SECONDS=20
TYPESAFE_API_KEY=
